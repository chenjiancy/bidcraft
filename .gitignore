*.py[cod]
.venv/
venv/
*.egg-info/
sidecar/dist/
sidecar/build/

# ===== 环境/密钥 =====
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ===== 运行时数据 =====
logs/
*.log
.tmp/
tmp/

