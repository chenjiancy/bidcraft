# ===== 样本数据 =====
# 投标文件等含敏感信息（证书/身份证/社保/合同）的样本仅存本机，绝不入库
samples-local/
# 公开招标文件样本中大体积文件不入库（按需，>50MB 由用户本地保留）
samples/**/*.bin

# ===== 依赖与构建产物 =====
node_modules/
dist/
dist-electron/
out/
release/
*.tsbuildinfo
__pycache__/
*.py[cod]
.venv/
venv/
# MinerU 独立重依赖环境（Task 8：torch/paddle 数 GB，不随 sidecar 主 venv 入库）
.venv-mineru/
*.egg-info/
sidecar/dist/
sidecar/build/
# NSIS 打包前的 sidecar exe / MinerU 运行时 / 模型 staging（数 GB，由 scripts/build-*.ps1 生成）
build-staging/

# ===== 环境/密钥 =====
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ===== 运行时数据 =====
logs/
*.log
.tmp/
tmp/

# ===== 系统/编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ===== 测试 =====
coverage/
.pytest_cache/
playwright-report/
test-results/

# 本地工作流复盘与内部笔记（永不入库）
docs/local/
